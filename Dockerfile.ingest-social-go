# ── Build Go binary ─────────────────────────────────────────────
FROM golang:1.22-alpine AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
WORKDIR /src/ingest-social-go
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o ingest-social-go .

# ── Runtime: Python + Uvicorn orchestrator + Go binary ─────────
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# TLS and basics
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

# FastAPI deps (or use requirements.txt if you have one)
RUN pip install --no-cache-dir fastapi uvicorn

# Orchestrator
COPY ingest-social-go/orchestrator.py /app/orchestrator.py

# Go runner
COPY --from=gobuild /src/ingest-social-go/ingest-social-go /app/ingest-social-go
RUN chmod +x /app/ingest-social-go

# Serve FastAPI by default
EXPOSE 8081
ENTRYPOINT ["python","-m","uvicorn","orchestrator:app","--host","0.0.0.0","--port","8081"]
