# Build the Go runner
FROM golang:1.24.4-alpine AS gobuild
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
WORKDIR /app/ingest-social-go
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o ingest-social-go .

# Runtime: Python (FastAPI) + the Go runner in the same image
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# TLS certs for outbound HTTPS
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

# Install FastAPI + k8s client
RUN pip install --no-cache-dir fastapi uvicorn kubernetes

# Copy FastAPI file (orchestrator) and the Go runner binary
COPY orchestrator.py /app/orchestrator.py
COPY --from=gobuild /app/ingest-social-go/ingest-social-go /usr/local/bin/ingest-social-go

# Default: run the FastAPI so you can POST /jobs/*
EXPOSE 8081
ENTRYPOINT ["python", "-m", "uvicorn", "orchestrator:app", "--host", "0.0.0.0", "--port", "8081"]
