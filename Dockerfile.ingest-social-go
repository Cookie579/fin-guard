# ── Build ─────────────────────────────────────────
FROM golang:1.24.4-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
WORKDIR /app/ingest-social-go
RUN CGO_ENABLED=0 go build -o ingest-social-go .

# ── Runtime ───────────────────────────────────────
FROM alpine:latest
RUN apk add --no-cache ca-certificates
WORKDIR /root/
COPY --from=builder /app/ingest-social-go/ingest-social-go .
# config is mounted at /app/config.json by the Job
ENTRYPOINT ["./ingest-social-go"]
