FROM golang:1.22-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

WORKDIR /app/ingest-esg-go
RUN go build -o ingest-esg-go .

FROM alpine:latest
WORKDIR /root/

COPY --from=builder /app/ingest-esg-go/ingest-esg-go .
COPY companies.json .
COPY config.json .


ENTRYPOINT ["./ingest-esg-go"]
