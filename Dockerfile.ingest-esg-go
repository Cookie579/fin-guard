# ──────────────────────────────
# 1) Build stage – compile Go
# ──────────────────────────────
FROM golang:1.24-alpine AS builder

# Set build context to root of repo
WORKDIR /build

# Download Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy all source
COPY . .

# Build the Go binary from ingest-esg-go/
RUN cd ingest-esg-go && go build -o /build/ingest-esg-go .

# ──────────────────────────────
# 2) Runtime stage – Python + Go
# ──────────────────────────────
FROM python:3.12-slim

# Install required system packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libjpeg-turbo-progs && \
    rm -rf /var/lib/apt/lists/*

# Set working directory inside container
WORKDIR /app

# Copy compiled Go binary
COPY --from=builder /build/ingest-esg-go .

# Copy trigger script and utils (extractor.py, etc.)
COPY ingest-esg-go/trigger.py .
COPY ingest-esg-go/utils ./utils

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi uvicorn boto3 \
    pdfplumber beautifulsoup4 lxml

# Expose FastAPI default port
EXPOSE 8080

# Start FastAPI server when container runs
CMD ["uvicorn", "trigger:app", "--host", "0.0.0.0", "--port", "8080"]
