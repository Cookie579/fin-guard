FROM python:3.12-slim

# Build arguments allow overriding the Go version at build time.
ARG GO_VERSION=1.24.4

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates bash \
 && curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz -o /tmp/go.tgz \
 && rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tgz \
 && rm -f /tmp/go.tgz \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/go/bin:${PATH}" \
    GOTOOLCHAIN=auto \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install Python dependencies for the orchestrator and kubernetes client.
RUN pip install --no-cache-dir fastapi uvicorn kubernetes

WORKDIR /app
COPY . .

# Copy and make the bootstrap script executable.
COPY ingest-esg-go/bootstrap.sh /app/bootstrap.sh
RUN chmod +x /app/bootstrap.sh

# Build the Go ingest binary during the image build. This avoids
# recompilation on container startup and ensures the binary is present for
# Jobs launched by the orchestrator. The binary will be located at
# /app/bin/ingest-esg-go. If you change this path, update k8s_launcher.py accordingly.
RUN mkdir -p /app/bin && \
    CGO_ENABLED=0 /usr/local/go/bin/go build -trimpath -ldflags "-s -w" \
    -o /app/bin/ingest-esg-go ./ingest-esg-go

EXPOSE 8081
ENTRYPOINT ["/bin/bash", "/app/bootstrap.sh"]