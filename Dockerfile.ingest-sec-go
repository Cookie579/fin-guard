# ────────────────────────────────
# Stage 1: Build
# ────────────────────────────────
FROM golang:1.21-alpine AS builder
WORKDIR /app

# Copy module files from ingest-sec-go
COPY ingest-sec-go/go.mod ingest-sec-go/go.sum ./
RUN go mod download

# Copy the ingest-sec-go source
COPY ingest-sec-go/ ./ingest-sec-go/

# ✅ Copy shared utils module too
COPY utils/ ./utils/

# Build the binary
WORKDIR /app/ingest-sec-go
RUN go build -o ingest-sec-go .

# ────────────────────────────────
# Stage 2: Runtime (minimal)
# ────────────────────────────────
FROM alpine:latest
WORKDIR /root/

# Copy the compiled binary
COPY --from=builder /app/ingest-sec-go/ingest-sec-go .

# Copy companies.json if needed
COPY ingest-sec-go/companies.json .

ENTRYPOINT ["./ingest-sec-go"]
