# ────────────────────────────────
# Stage 1: Build
# ────────────────────────────────
FROM golang:1.21-alpine AS builder
WORKDIR /app

# Copy Go module files and install dependencies
COPY ingest-sec-go/go.mod ingest-sec-go/go.sum ./
RUN go mod download

# Copy Go source
COPY ingest-sec-go/ ./

# Build the Go binary
RUN go build -o ingest-sec-go .

# ────────────────────────────────
# Stage 2: Runtime (minimal)
# ────────────────────────────────
FROM alpine:latest
WORKDIR /root/

# Copy the compiled binary
COPY --from=builder /app/ingest-sec-go .

# ✅ Copy companies.json
COPY --from=builder /app/companies.json .

# Entrypoint
ENTRYPOINT ["./ingest-sec-go"]
