# Stage 1: Build
FROM golang:1.21-alpine AS builder
WORKDIR /app
COPY ingest-sec-go/go.mod ./
RUN go mod download
COPY ingest-sec-go/ ./
RUN go build -o ingest-sec-go

# Stage 2: Minimal runtime image
FROM alpine:latest
WORKDIR /root/
COPY --from=builder /app/ingest-sec-go .
ENTRYPOINT ["./ingest-sec-go"]
