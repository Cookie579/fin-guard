# ────────────────────────────────
# Stage 1: Build
# ────────────────────────────────
FROM golang:1.21-alpine AS builder
WORKDIR /app

# ✅ Copy root-level Go module files
COPY go.mod go.sum ./
RUN go mod download

# ✅ Copy the entire source tree (now all code is in a single module)
COPY . .

# ✅ Set working directory for the service
WORKDIR /app/ingest-sec-go

# ✅ Build the binary
RUN go build -o ingest-sec-go .

# ────────────────────────────────
# Stage 2: Runtime (minimal)
# ────────────────────────────────
FROM alpine:latest
WORKDIR /root/

# Copy the compiled binary
COPY --from=builder /app/ingest-sec-go/ingest-sec-go .

# Copy companies.json from root if needed
COPY companies.json .

ENTRYPOINT ["./ingest-sec-go"]
