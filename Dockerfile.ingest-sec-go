# syntax=docker/dockerfile:1

# Base: Python for FastAPI orchestrator, plus we'll install Go toolchain.
FROM python:3.12-slim

ARG GO_VERSION=1.24.4

# Minimal OS deps + install Go toolchain
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates bash tini \
 && curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz -o /tmp/go.tgz \
 && rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tgz \
 && rm -f /tmp/go.tgz \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/go/bin:${PATH}" \
    GOTOOLCHAIN=auto \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Python deps for the orchestrator
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" kubernetes boto3 requests

WORKDIR /app

# Copy repo contents (adjust if you build from a subdir)
COPY . .

# Build the Go runner once at image build time → /app/bin/ingest-sec-go
RUN mkdir -p /app/bin && \
    CGO_ENABLED=0 /usr/local/go/bin/go build -trimpath -ldflags "-s -w" \
      -o /app/bin/ingest-sec-go ./ingest-sec-go

# Add bootstrap to launch orchestrator so the Deployment stays up
COPY ingest-sec-go/bootstrap.sh /app/bootstrap.sh
RUN chmod +x /app/bootstrap.sh

EXPOSE 8081

ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["/bin/bash","/app/bootstrap.sh"]
