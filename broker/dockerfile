# Build stage
FROM golang:1.24 AS build
ENV GOTOOLCHAIN=auto
WORKDIR /src

# module deps (better cache)
COPY go.mod go.sum ./
RUN go mod download

# source
COPY . .

# build the broker (single root module; code lives in /broker)
WORKDIR /src/broker
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/rate-broker .

# Run stage
FROM gcr.io/distroless/base-debian12
COPY --from=build /out/rate-broker /rate-broker
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/rate-broker"]
