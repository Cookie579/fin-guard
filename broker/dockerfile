# build
FROM golang:1.22 as build
WORKDIR /src
COPY go.mod .
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/rate-broker ./main.go

# run
FROM gcr.io/distroless/base-debian12
ENV LISTEN_ADDR=:8080
COPY --from=build /out/rate-broker /rate-broker
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/rate-broker"]
